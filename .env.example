FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///instance/servicedesk.db

# Ollama settings — Ollama must be installed and running locally (or reachable at this host)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Set to "true" to run agents in mock mode (no LLM calls) — useful for demos without Ollama installed
AGENT_MOCK_MODE=false
